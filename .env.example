# Copy this file to .env. Do not commit .env.

# Signs the officer session cookie. Required in production. Use a long random value.
NIVADA_SESSION_SECRET=

# Single demo officer. Required for sign-in. Do not commit the real values.
NIVADA_OFFICER_USERNAME=
NIVADA_OFFICER_PASSWORD=

# Claude writes the Marathi brief. Without a key, the desk still shows the rule-based brief.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
